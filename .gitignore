# --- Ansys Lumerical projects, logs and raw results ---
# Projects reach tens of MB and are rebuilt by the scripts.  Kept under version control instead:
# the layouts (.gds), the process file (.lbr), the result summaries (.txt, .csv), the figures (.png)
# and the result arrays of the tutorial device (.npz, 7 MB in total): with them every figure can be
# redrawn without Lumerical.
*.fsp
*.lms
*.ldev
*.icp
*.ich
*.mat
*.npz
!lumerical_simulations/ring_modulator/*/*.npz
*.h5
*.log
*_engine.out
~#*
*.lbr.bak

# --- editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

