# --- Python / uv ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
dist/
build/

# --- DRC marker databases (regenerated by every run) ---
*.lyrdb

# --- Ansys Lumerical projects, logs and raw results ---
# Projects reach tens of MB and are rebuilt by the scripts.  Kept under version control instead:
# the layouts (.gds), the process file (.lbr), the result summaries (.txt, .csv), the figures (.png)
# and the result arrays of the tutorial devices (.npz, 10 MB in total): with them every figure can be
# redrawn without Lumerical.
*.fsp
*.lms
*.ldev
*.icp
*.ich
*.mat
*.npz
!lumerical_simulations/*/*/*.npz
*.h5
*.log
*_engine.out
~#*
~$*
*.lbr.bak

# --- editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- set-up previews, written on demand by the FDTD scripts (--preview) ---
lumerical_simulations/*/figures/check_*.png

# --- scripts and source icons of the overview figures: kept locally, not published ---
assets/scripts/
assets/third_party/
assets/device_library.pptx

# --- the source of the website: kept locally, only the built pages are published (branch gh-pages) ---
website/

# --- scratch layout of the core-width sweep of step 2 (overwritten for every width) ---
rib_width_sweep.gds
